PORT=3000
# Client origin(s) allowed by CORS, comma-separated. Example: http://localhost:5173,https://your-client.example
CLIENT_ORIGIN=http://localhost:5173
# Set to production when deployed (makes the auth cookie SameSite=None; Secure)
NODE_ENV=

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# true for hosted MySQL providers that require TLS
DB_SSL=

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Jev key from https://console.typesafe.ai/keys, and the model
AI_API_KEY=
AI_MODEL=jev-latest
# Safety cap on firing time, in seconds
MAX_FIRE_SECONDS=2

# Local Python turret service
TURRET_URL=http://127.0.0.1:5000
TURRET_TIMEOUT_MS=10000
